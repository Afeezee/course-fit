# apps/api/.env.example
# Copy to apps/api/.env for local dev. On Railway, set these as service
# variables under the API service (not committed).

# --------------------------------------------------------------------
# CORS: comma-separated list of origins allowed to call this API.
# --------------------------------------------------------------------
# Local dev: the Next.js dev server on port 3000.
# Production: the deployed web service's Railway URL, e.g.
#   ${{web.RAILWAY_PUBLIC_DOMAIN}}
# — Railway's cross-service variable reference syntax. No wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------------
# Model bundle path, relative to apps/api/ (which is the working dir
# the start command cds into). Leave unset to use the default at
# ../../ml/best_model.joblib.
# --------------------------------------------------------------------
# MODEL_PATH=../../ml/best_model.joblib

# --------------------------------------------------------------------
# Optional: Groq LLM explanation upgrade.
# --------------------------------------------------------------------
# When GROQ_API_KEY is set, the API sends the student's profile +
# top-3 recommendations to Groq in one batched call, and uses the
# returned personalised explanations in place of the deterministic
# template from ml/recommend.py. If the key is missing OR the LLM
# call fails / times out for any reason, the API silently falls back
# to the deterministic template — /api/recommend never fails just
# because the LLM is down. Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Optional. Any Groq-hosted chat model. Defaults to
# llama-3.3-70b-versatile which balances explanation quality against
# latency (~500ms/call). For lower latency at the cost of prose
# quality, try llama-3.1-8b-instant.
GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------------------------
# Optional: Neon (Postgres) persistence for the landing-page activity
# feed. When DATABASE_URL is set, the anonymous OUTCOME of each
# recommendation (career interest + top course + fit%, no grades or
# personal answers) is inserted into a `recommendations` table, and
# GET /api/recent returns the most recent rows. When unset, both
# /api/recommend and /api/recent still work — recent just returns an
# empty list and the landing shows the static fact-card layout.
# Grab a free connection string at https://console.neon.tech/ — the
# format looks like:
#   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# --------------------------------------------------------------------
DATABASE_URL=

# --------------------------------------------------------------------
# Optional: Clerk sign-in for the per-user history feature.
# --------------------------------------------------------------------
# When CLERK_ISSUER is set, /api/history requires a valid Clerk JWT
# in the Authorization header and returns that user's past
# recommendations. /api/recommend is unchanged for anonymous callers
# but will additionally save a full user-linked snapshot when a valid
# token is present. If unset, /api/history returns 503 and only the
# anonymous flow works.
#
# The issuer is the "Frontend API" base URL shown in the Clerk
# dashboard, e.g.
#   https://neat-koala-42.clerk.accounts.dev   (Clerk dev instance)
#   https://clerk.your-domain.com               (Clerk prod)
CLERK_ISSUER=

