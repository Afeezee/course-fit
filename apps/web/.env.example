# apps/web/.env.example
# Copy to apps/web/.env.local for local dev. On Railway, set as a
# service variable under the web service.

# --------------------------------------------------------------------
# The API this frontend talks to. Baked into the client bundle at
# build time (NEXT_PUBLIC_ prefix), so rebuild the web service if this
# value changes.
# --------------------------------------------------------------------
# Local dev: the uvicorn server started with:
#   cd apps/api && uvicorn main:app --port 8000
# Production: the API service's public Railway domain, using Railway's
# cross-service variable reference syntax:
#   NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------
# Optional: Clerk sign-in / per-user history.
# --------------------------------------------------------------------
# Both keys are shown in the Clerk dashboard under API Keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is safe to expose (baked into
# client bundle). CLERK_SECRET_KEY is server-side only.
# If both are unset, the app still runs — the header just doesn't
# render the Sign-in button, /history is unreachable via middleware,
# and the wizard flow is unchanged.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
